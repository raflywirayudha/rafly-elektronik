---
const brands = [
  { src: "/rinnai.png", alt: "Logo Rinnai", className: "w-32" },
  { src: "/shimizu.png", alt: "Logo Shimizu", className: "w-32" },
  { src: "/miyako.png", alt: "Logo Miyako", className: "w-[150px]" },
];
---

<section class="border-y border-line bg-white py-8" aria-label="Mitra resmi brand">
  <div class="flex w-full flex-wrap items-center justify-center  gap-x-8 gap-y-5 md:w-auto lg:gap-x-14">
    {brands.map((brand) => (
      <img
        src={brand.src}
        alt={brand.alt}
        width="150"
        height="36"
        class={`h-8 object-contain opacity-70 grayscale transition duration-200 hover:opacity-100 hover:grayscale-0 sm:h-9 ${brand.className}`}
      />
    ))}
  </div>
</section>
