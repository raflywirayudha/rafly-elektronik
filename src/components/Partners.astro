---
import { Image } from "astro:assets";
import rinnaiUrl from "../assets/partners/rinnai.png";
import shimizuUrl from "../assets/partners/shimizu.png";
import miyakoUrl from "../assets/partners/miyako.png";

const brands = [
  { src: rinnaiUrl, alt: "Logo Rinnai", className: "w-32" },
  { src: shimizuUrl, alt: "Logo Shimizu", className: "w-46" },
  { src: miyakoUrl, alt: "Logo Miyako", className: "w-[150px]" },
];
---

<section class="border-y border-line bg-white py-8" aria-label="Mitra resmi brand">
  <div class="container">
    <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-5 lg:gap-x-14">
      {brands.map((brand) => (
        <Image
          src={brand.src}
          alt={brand.alt}
          width="160"
          height="40"
          class={`h-8 object-contain opacity-70 grayscale transition duration-200 hover:opacity-100 hover:grayscale-0 sm:h-9 ${brand.className}`}
        />
      ))}
    </div>
  </div>
</section>
