---
const navItems = [
  { href: "#layanan", label: "Layanan" },
  { href: "#tentang", label: "Tentang Kami" },
  { href: "#lokasi", label: "Lokasi" },
  { href: "#kontak", label: "Kontak" },
];
---

<header id="siteHeader" class="site-header fixed inset-x-0 top-0 z-20 border-b border-transparent bg-transparent">
  <nav class="container flex min-h-[80px] items-center justify-between gap-6" aria-label="Navigasi utama">
    <a href="#beranda" class="brand flex items-center gap-2.5 font-display text-lg font-bold text-white">
      <span class="brand-wordmark" aria-label="Rafly Elektronik">
        <span class="brand-name">Rafly</span>
        <span class="brand-subtitle">Elektronik</span>
      </span>
    </a>

    <div id="navLinks" class="nav-links">
      {navItems.map((item) => (
        <a href={item.href} class="nav-link">
          {item.label}
        </a>
      ))}
    </div>

    <!-- <a href="#kontak" class="header-cta btn btn-primary hidden lg:inline-flex">
      Chat WhatsApp
    </a> -->

    <button
      id="menuToggle"
      type="button"
      class="menu-toggle grid h-11 w-11 place-items-center border border-white/30 text-white transition-colors lg:hidden"
      aria-label="Buka menu"
      aria-controls="navLinks"
      aria-expanded="false"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </nav>
</header>

<style>
  .site-header {
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      backdrop-filter 0.25s ease;
  }

  .site-header.scrolled {
    background: rgb(251 250 247 / 0.9);
    border-bottom-color: rgb(219 229 236 / 0.8);
    box-shadow: 0 8px 24px rgb(16 42 67 / 0.07);
    backdrop-filter: blur(18px);
  }

  .site-header.scrolled .brand {
    color: var(--color-navy);
  }

  .site-header.scrolled .nav-link {
    color: #496277;
  }

  .site-header.scrolled .menu-toggle {
    color: var(--color-navy);
    border-color: var(--color-line);
  }

   .brand-wordmark {
     position: relative;
     display: inline-flex;
     flex-direction: column;
     line-height: 0.88;
   }

   .brand-name {
     font-size: 1.2rem;
     font-weight: 700;
     letter-spacing: -0.09em;
     text-transform: uppercase;
   }

   .brand-subtitle {
     margin-top: 0.35rem;
     color: var(--color-ember);
     font-family: var(--font-sans);
     font-size: 1.2rem;
     font-weight: 700;
     letter-spacing: -0.04em;
     text-transform: uppercase;
   }

  .nav-link {
    position: relative;
    font-size: 0.9rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.86);
    transition: color 0.2s ease;
  }

  .header-cta {
    min-height: 2.75rem;
    padding-inline: 1.1rem;
    font-size: 0.7rem;
  }

  .nav-link:hover {
    color: var(--color-ember);
  }

  .nav-link::after {
    position: absolute;
    right: 0;
    bottom: -0.6rem;
    left: 0;
    height: 2px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.2s ease;
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header.scrolled .nav-link:hover {
    color: var(--color-orange-dark);
  }

  @media (min-width: 1024px) {
    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
    }
  }

  @media (max-width: 1023.98px) {
    .nav-links {
      position: absolute;
      inset-inline: 1.25rem;
      top: 4.5rem;
      display: none;
      flex-direction: column;
      gap: 0;
      padding: 0.625rem;
      background: #fff;
      border: 1px solid var(--color-line);
      border-left: 4px solid var(--color-orange);
      box-shadow: 8px 8px 0 rgb(9 34 56 / 0.12);
    }

    .nav-links.open {
      display: flex;
    }

    .nav-link {
      padding: 0.75rem;
      color: #496277;
    }

    .nav-link::after {
      display: none;
    }

    .nav-link:hover {
      background: rgb(242 155 56 / 0.08);
    }
  }
</style>

<script>
  const toggle = document.getElementById("menuToggle");
  const panel = document.getElementById("navLinks");
  const header = document.getElementById("siteHeader");

  if (
    toggle instanceof HTMLButtonElement &&
    panel instanceof HTMLElement &&
    header instanceof HTMLElement
  ) {
    const updateHeader = () => {
      header.classList.toggle("scrolled", window.scrollY > 24);
    };

    const firstLink = panel.querySelector<HTMLAnchorElement>("a");

    const closeMenu = (restoreFocus = false) => {
      panel.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute("aria-label", "Buka menu");
      if (restoreFocus) toggle.focus();
    };

    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });

    toggle.addEventListener("click", () => {
      const open = panel.classList.toggle("open");
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Tutup menu" : "Buka menu");
      if (open) firstLink?.focus();
    });

    panel.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => closeMenu()),
    );

    document.addEventListener("click", (event) => {
      if (!panel.classList.contains("open")) return;
      if (event.target instanceof Node && !header.contains(event.target)) {
        closeMenu();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !panel.classList.contains("open")) return;
      closeMenu(true);
    });
  }
</script>
