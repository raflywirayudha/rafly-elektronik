---
import { business } from "../data/business";

const quickLinks = [
  { href: "#tentang", label: "Tentang Kami" },
  { href: "#layanan", label: "Layanan" },
  { href: "#lokasi", label: "Lokasi" },
  { href: "#kontak", label: "Kontak" },
];
---

<footer class="border-t border-white/10 bg-footer py-12 text-sm text-[#aabfcd]">
  <div class="container flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
    <a href="#beranda" class="flex items-center gap-2.5 font-display text-lg font-bold text-white">
      <span
        class="grid h-10 w-10 place-items-center border border-orange bg-orange text-xs font-bold tracking-[0.08em] text-navy"
        aria-hidden="true"
      >
        RE
      </span>
      <span>Rafly Elektronik</span>
    </a>

    <p>© 2026 {business.name}. Servis resmi elektronik Tembilahan.</p>

    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
      {quickLinks.map((link) => (
        <a href={link.href} class="transition-colors hover:text-white">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
