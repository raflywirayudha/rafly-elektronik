---
const details = [
  { label: "WhatsApp", value: "0822-8888-XXXX" },
  { label: "Telepon", value: "0812-7616-XXXX" },
  { label: "Email", value: "bass.XXXXXX@gmail.com" },
];
---

<section id="kontak" class="pb-24 pt-8 lg:pb-28 lg:pt-10">
  <div class="container">
    <div class="rounded-[3px] bg-linear-to-r from-gold via-amber to-orange p-9 shadow-[0_18px_35px_rgba(16,42,67,0.1)] lg:grid lg:grid-cols-[1fr_0.85fr] lg:gap-14 lg:p-14">
      <div>
        <p class="kicker">Butuh bantuan?</p>
        <h2 class="mt-3 font-display text-[clamp(2.25rem,4vw,3rem)] leading-[1.05] tracking-[-0.05em] text-navy">
          Ceritakan masalah perangkat Anda.
        </h2>
        <p class="mt-4 max-w-[520px] text-[#62451f]">
          Kontak kami untuk menanyakan ketersediaan servis, estimasi pengecekan,
          atau lokasi toko.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#kontak" class="btn btn-dark" data-whatsapp>
            Chat WhatsApp <span aria-hidden="true">↗</span>
          </a>
          <a href="#kontak" class="btn btn-outline" data-phone>
            Telepon toko
          </a>
        </div>
      </div>

      <div class="pt-6 lg:border-l lg:border-navy/25 lg:pl-8 lg:pt-0">
        {details.map((detail) => (
          <p class="mb-4 text-sm text-[#62451f]">
            <strong class="block font-display text-base text-navy">{detail.label}</strong>
            {detail.value}
          </p>
        ))}
        <p class="mt-6 text-sm text-[#62451f]">
          Nomor lengkap akan diperbarui setelah dikonfirmasi.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll("[data-whatsapp], [data-phone]").forEach((link) =>
    link.addEventListener("click", (event) => {
      event.preventDefault();
      alert("Nomor kontak lengkap Rafly Elektronik akan segera ditambahkan.");
    }),
  );
</script>