---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const imageModules = import.meta.glob<ImageMetadata>(
  "/src/assets/gallery/*.webp",
  { eager: true, import: "default" },
);

const photos = Object.entries(imageModules)
  .map(([path, src]) => ({
    src,
    label: path.match(/photo_(\d+)/)?.[1] ?? path,
  }))
  .sort((a, b) => Number(a.label) - Number(b.label));
---

<section id="galeri" class="border-b border-line/80 bg-white py-24 lg:py-30">
  <div class="container">
    <div class="mb-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-end lg:mb-12">
      <div>
        <p class="section-label kicker">Galeri</p>
        <h2 class="mt-3 max-w-162.5 font-display text-[clamp(2.1rem,4vw,3.5rem)] leading-[1.08] tracking-[-0.055em] text-navy">
           Layanan kami dalam dokumentasi
        </h2>
      </div>
    </div>

    <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
      {photos.map((photo, index) => (
        <button
          type="button"
          class="group relative mb-4 block w-full break-inside-avoid cursor-zoom-in overflow-hidden border border-line bg-cream transition duration-300 focus-visible:outline-offset-2 hover:z-1 hover:-translate-y-1 hover:border-orange hover:shadow-[7px_7px_0_rgba(9,34,56,0.12)]"
          data-lightbox-open={index}
          aria-label={`Buka foto galeri ${photo.label} dalam tampilan besar`}
        >
          <Image
            src={photo.src}
            alt={`Foto galeri ${photo.label} Rafly Elektronik`}
            class="w-full transition-transform duration-300 group-hover:scale-[1.03]"
            loading="lazy"
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          />
          {/* <span class="absolute right-0 bottom-0 border-t border-l border-white/25 bg-navy/90 px-3 py-2 text-[0.65rem] font-bold tracking-[0.14em] text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100">
            LIHAT FOTO {String(index + 1).padStart(2, "0")}
          </span> */}
        </button>
      ))}
    </div>
  </div>
</section>

<dialog
  id="lightbox"
  class="m-auto max-h-[92vh] w-[min(1100px,92vw)] overflow-hidden border border-white/15 bg-navy p-0 text-white shadow-2xl backdrop:bg-navy/90"
  aria-label="Tampilan besar foto galeri"
>
  <div class="relative">
    <img id="lightboxImage" class="block max-h-[88vh] w-full object-contain" alt="" />
    <button
      id="lightboxPrev"
      type="button"
      class="absolute top-1/2 left-3 grid h-12 w-12 -translate-y-1/2 place-items-center border border-white/30 bg-navy/75 backdrop-blur transition-colors hover:border-orange hover:bg-navy sm:left-4"
      aria-label="Foto sebelumnya"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <button
      id="lightboxNext"
      type="button"
      class="absolute top-1/2 right-3 grid h-12 w-12 -translate-y-1/2 place-items-center border border-white/30 bg-navy/75 backdrop-blur transition-colors hover:border-orange hover:bg-navy sm:right-4"
      aria-label="Foto berikutnya"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
    <button
      id="lightboxClose"
      type="button"
      class="absolute top-3 right-3 grid h-11 w-11 place-items-center border border-white/30 bg-navy/75 backdrop-blur transition-colors hover:border-orange hover:bg-navy"
      aria-label="Tutup tampilan besar"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
  <p id="lightboxCaption" class="px-4 py-2 text-center text-xs tracking-wide text-[#aac0ce]" aria-live="polite"></p>
</dialog>

<script>
  const dialog = document.getElementById("lightbox");
  const imageEl = document.getElementById("lightboxImage");
  const prevBtn = document.getElementById("lightboxPrev");
  const nextBtn = document.getElementById("lightboxNext");
  const closeBtn = document.getElementById("lightboxClose");
  const caption = document.getElementById("lightboxCaption");
  const images = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-lightbox-open]"),
  );

  let current = 0;

  if (
    dialog instanceof HTMLDialogElement &&
    imageEl instanceof HTMLImageElement &&
    prevBtn instanceof HTMLButtonElement &&
    nextBtn instanceof HTMLButtonElement &&
    closeBtn instanceof HTMLButtonElement &&
    caption instanceof HTMLElement &&
    images.length > 0
  ) {
    const update = () => {
      const source = images[current]?.querySelector<HTMLImageElement>("img");
      if (!source) return;

      imageEl.src = source.currentSrc || source.src;
      imageEl.alt = source.alt;
      caption.textContent = `Foto ${current + 1} dari ${images.length}`;
    };

    const open = (index: number) => {
      current = index;
      update();
      dialog.showModal();
    };

    images.forEach((image, index) =>
      image.addEventListener("click", () => open(index)),
    );

    prevBtn.addEventListener("click", () => {
      current = (current - 1 + images.length) % images.length;
      update();
    });

    nextBtn.addEventListener("click", () => {
      current = (current + 1) % images.length;
      update();
    });

    closeBtn.addEventListener("click", () => dialog.close());

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("close", () => images[current]?.focus());

    document.addEventListener("keydown", (event) => {
      if (!dialog.open) return;
       if (event.key === "ArrowLeft") {
         event.preventDefault();
         prevBtn.click();
       }
       if (event.key === "ArrowRight") {
         event.preventDefault();
         nextBtn.click();
       }
    });
  }
</script>
