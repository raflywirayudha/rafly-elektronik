---
const iconStyle =
  'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';

const services = [
  {
    title: "Servis Kompor Gas",
    description: "Perbaikan, pengecekan, dan penggantian komponen kompor gas Rinnai.",
    badge: "Mitra resmi Rinnai",
    icon: `<svg viewBox="0 0 24 24" ${iconStyle}><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
  },
  {
    title: "Servis Pompa Air",
    description: "Instalasi dan perbaikan mesin pompa air untuk kebutuhan rumah maupun usaha.",
    badge: "Mitra resmi Shimizu",
    icon: `<svg viewBox="0 0 24 24" ${iconStyle}><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>`,
  },
  {
    title: "Peralatan Miyako",
    description: "Penanganan rice cooker, blender, kipas angin, dispenser, dan perangkat Miyako lainnya.",
    badge: "Mitra resmi Miyako",
    icon: `<svg viewBox="0 0 24 24" ${iconStyle}><path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/></svg>`,
  },
  {
    title: "Suku Cadang Asli",
    description: "Sparepart original untuk menjaga performa dan usia pakai perangkat Anda.",
    badge: "Original parts",
    icon: `<svg viewBox="0 0 24 24" ${iconStyle}><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  },
];
---

<section id="layanan" class="py-24 lg:py-[105px]">
  <div class="container">
    <div class="mb-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-end lg:mb-12">
      <div>
        <p class="kicker">Yang kami kerjakan</p>
        <h2 class="mt-3 max-w-[650px] font-display text-[clamp(2.1rem,4vw,3.5rem)] leading-[1.08] tracking-[-0.055em] text-navy">
          Servis untuk perangkat yang bekerja setiap hari.
        </h2>
      </div>
      <p class="max-w-[400px] text-muted">
        Mulai dari pemeriksaan hingga penggantian komponen, kami membantu perangkat rumah Anda kembali berfungsi.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {services.map((service) => (
        <article
          class="flex min-h-[260px] flex-col rounded-[3px] border border-line/90 bg-linear-to-br from-white via-white to-papaya p-6 transition-transform duration-200 hover:-translate-y-1.5 hover:border-[#f0be7d] hover:shadow-[0_20px_35px_rgba(16,42,67,0.08)]"
        >
          <div
            class="mb-6 grid h-12 w-12 place-items-center rounded-[3px] bg-linear-to-br from-navy via-blue to-orange text-white shadow-[0_8px_15px_rgba(16,42,67,0.14)]"
            aria-hidden="true"
          >
            <span set:html={service.icon} class="h-6 w-6" />
          </div>
          <h3 class="font-display text-lg tracking-[-0.02em] text-navy">{service.title}</h3>
          <p class="mt-3 mb-4 text-[0.9rem] text-muted">{service.description}</p>
          <span class="mt-auto text-xs font-bold uppercase tracking-[0.06em] text-orange-dark">
            {service.badge}
          </span>
        </article>
      ))}
    </div>
  </div>
</section>