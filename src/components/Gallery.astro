---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const imageModules = import.meta.glob<ImageMetadata>(
  "/src/assets/gallery/*.{jpg,jpeg}",
  { eager: true, import: "default" },
);

const photos = Object.entries(imageModules)
  .map(([path, src]) => ({
    src,
    label: path.match(/photo_(\d+)/)?.[1] ?? path,
  }))
  .sort((a, b) => Number(a.label) - Number(b.label));
---

<section id="galeri" class="py-24 lg:py-[105px]">
  <div class="container">
    <div class="mb-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-end lg:mb-12">
      <div>
        <p class="kicker">Galeri</p>
        <h2 class="mt-3 max-w-[650px] font-display text-[clamp(2.1rem,4vw,3.5rem)] leading-[1.08] tracking-[-0.055em] text-navy">
          Lihat hasil kerja kami.
        </h2>
      </div>
      <p class="max-w-[400px] text-muted">
        Sampel pekerjaan servis dan kondisi toko Rafly Elektronik.
      </p>
    </div>

    <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
      {photos.map((photo, index) => (
        <button
          type="button"
          class="group mb-4 block w-full break-inside-avoid cursor-zoom-in overflow-hidden rounded-[3px] border border-line/70 transition-transform duration-200 focus-visible:outline-offset-2 hover:-translate-y-1"
          data-lightbox-open={index}
          aria-label={`Buka foto galeri ${photo.label} dalam tampilan besar`}
        >
          <Image
            src={photo.src}
            alt={`Foto galeri ${photo.label} Rafly Elektronik`}
            class="w-full transition-transform duration-300 group-hover:scale-[1.03]"
            loading="lazy"
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
          />
        </button>
      ))}
    </div>
  </div>
</section>

<dialog
  id="lightbox"
  class="m-auto w-[min(1100px,92vw)] max-h-[92vh] overflow-hidden rounded-[3px] border-0 bg-navy p-0 text-white shadow-2xl backdrop:bg-navy/85"
  aria-label="Tampilan besar foto galeri"
>
  <div class="relative">
    <img id="lightboxImage" class="block max-h-[88vh] w-full object-contain" alt="" />
    <button
      id="lightboxPrev"
      type="button"
      class="absolute top-1/2 left-4 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-white/25 bg-navy/60 text-xl backdrop-blur transition-colors hover:bg-navy"
      aria-label="Foto sebelumnya"
    >
      ‹
    </button>
    <button
      id="lightboxNext"
      type="button"
      class="absolute top-1/2 right-4 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full border border-white/25 bg-navy/60 text-xl backdrop-blur transition-colors hover:bg-navy"
      aria-label="Foto berikutnya"
    >
      ›
    </button>
    <button
      id="lightboxClose"
      type="button"
      class="absolute top-3 right-3 grid h-10 w-10 place-items-center rounded-full border border-white/25 bg-navy/60 text-lg backdrop-blur transition-colors hover:bg-navy"
      aria-label="Tutup tampilan besar"
    >
      ✕
    </button>
  </div>
  <p id="lightboxCaption" class="px-4 py-2 text-center text-xs tracking-wide text-[#aac0ce]"></p>
</dialog>

<script>
  const dialog = document.getElementById("lightbox");
  const imageEl = document.getElementById("lightboxImage");
  const prevBtn = document.getElementById("lightboxPrev");
  const nextBtn = document.getElementById("lightboxNext");
  const closeBtn = document.getElementById("lightboxClose");
  const caption = document.getElementById("lightboxCaption");
  const images = Array.from(document.querySelectorAll("[data-lightbox-open]"));

  let current = 0;

  const update = () => {
    imageEl.src = images[current].querySelector("img").getAttribute("src");
    imageEl.alt = images[current].querySelector("img").getAttribute("alt");
    caption.textContent = `Foto ${current + 1} dari ${images.length}`;
  };

  const open = (index) => {
    current = index;
    update();
    dialog.showModal();
  };

  images.forEach((img, index) =>
    img.addEventListener("click", () => open(index)),
  );

  prevBtn.addEventListener("click", () => {
    current = (current - 1 + images.length) % images.length;
    update();
  });

  nextBtn.addEventListener("click", () => {
    current = (current + 1) % images.length;
    update();
  });

  closeBtn.addEventListener("click", () => dialog.close());

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.addEventListener("keydown", (event) => {
    if (!dialog.open) return;
    if (event.key === "ArrowLeft") prevBtn.click();
    if (event.key === "ArrowRight") nextBtn.click();
  });
</script>